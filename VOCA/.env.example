# Runtime assets
VOCA_SCENE_DATASETS_DIR=/path/to/habitat/scene_datasets
VOCA_DATASETS_DIR=/path/to/habitat/episode_datasets
VOCA_POLICY_CHECKPOINT=/path/to/pixelnav_A.ckpt
VOCA_YOLOE_CHECKPOINT=/path/to/yoloe-11l-seg.pt
VOCA_DEVICE=cuda:0

# OpenAI-compatible local Qwen-VL server
VOCA_LLM_BACKEND=qwen
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL=qwen3-vl-32b-thinking-awq
VOCA_QWEN_MODEL_ROOT=QuantTrio/Qwen3-VL-32B-Thinking-AWQ

# Integrated runner
VOCA_PLANNER=qwen_vlm
VOCA_LOCALIZATION_SOURCE=habitat_sim_pose_declared
VOCA_ALLOW_SIM_POSE_POLICY=1
VOCA_MAX_EPISODE_STEPS=1000
VOCA_QWEN_MEMORY_SIDECAR=1
VOCA_PIXELNAV_CANDIDATE_SCORING=1

# Optional derived coarse-goal protocol
VOCA_BENCHMARK_PROTOCOL=hm3d_derived_coarse_goalnav_v1_sim_pose_noise0p5
VOCA_COARSE_GOAL_FILE=/path/to/VOCA/configs/coarse_goals/hm3d_val_seed20260710_ep0_2_noise0p5.json
VOCA_COARSE_GOAL_EXPECTED_SHA256=be0dbc1a36227f9dabb226b7f0de19a1d53501560044420802d82262ca1739a7
